[Unit]
Description=Zerodha Auto-Login for %i (daily token refresh)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/trading-algo
Environment=ALGO_USER_DIR=/opt/algo-users/%i
ExecStart=/opt/trading-algo/venv/bin/python scripts/auto_login.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-login-%i
