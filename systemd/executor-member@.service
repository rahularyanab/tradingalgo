[Unit]
Description=Theta Desk member PAPER trial (%i) — follows the executor API at their plan size, never sends an order
After=network-online.target executor-api.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/trading-algo
Environment=EXECUTOR_HOME=/opt/trading-algo/executor_members/%i
ExecStart=/opt/trading-algo/venv/bin/python -m executor run
Restart=always
RestartSec=20
MemoryMax=60M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=executor-member-%i

[Install]
WantedBy=multi-user.target
