[Unit]
Description=Theta Desk fleet — creates and manages one trading droplet per auto-trading subscriber
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/trading-algo
# Reads fleet.env itself (DO token); never the trading bot's .env
ExecStart=/opt/trading-algo/venv/bin/python -m publish.fleet
Restart=always
RestartSec=30
MemoryMax=120M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fleet

[Install]
WantedBy=multi-user.target
