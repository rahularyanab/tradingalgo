# Settings for publish/fleet.py. Copy to /opt/trading-algo/fleet.env, chmod 600. Never commit.
# DigitalOcean API token: custom scopes, droplet (create/read/update/delete) + ssh_key (create/read) + tag (read).
DO_TOKEN=
# Most subscriber droplets that may exist at once (cost guard, ~$4 each per month).
FLEET_MAX=10
# Public address of the setup page (needs a domain pointed at this server + Caddy).
SETUP_BASE_URL=
