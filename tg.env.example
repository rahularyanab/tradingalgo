# Telegram settings for publish/telegram_live.py. Copy to /opt/trading-algo/tg.env on the server, chmod 600.
# A NEW bot from @BotFather — never the trading bot's own alerts bot (two processes polling one token = 409 Conflict).
TG_BOT_TOKEN=
# The public channel, e.g. @ThetaDeskLive. Add the bot as an admin with "Post messages".
TG_CHANNEL=
# 0 = dry run (channel posts and DMs written to logs/tg_dryrun.log). 1 = send for real.
# The bot answers people who message it in either mode.
TG_LIVE=0
