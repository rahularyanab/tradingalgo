# X (Twitter) keys for publish/x_poster.py. Copy to /opt/trading-algo/x.env on the server, chmod 600.
# From developer.x.com -> your app -> Keys and tokens. The app's permissions must be "Read and write",
# and the Access Token must be generated AFTER setting that (regenerate it if you changed permissions).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# 0 = dry run (writes logs/x_poster_dryrun.log, posts nothing). 1 = post to X for real.
X_LIVE=0
# Minutes X runs behind the trades (live alerts are for subscribers). 0 = real time. Greeting and quote are never delayed.
X_DELAY_MIN=5
